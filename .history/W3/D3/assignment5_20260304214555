let wallet = {
    owner: "Rhaashee",
    balance: 500,
    lastTransaction: null,

    deposit: function(amount) {

        if (typeof amount !== "number" || amount <= 0) {
            console.log("Invalid amount");
            return;
        }

        this.balance = this.balance + amount;

        this.lastTransaction = {
            type: "DEPOSIT",
            amount: amount,
            balanceAfter: this.balance
        };
    },
}